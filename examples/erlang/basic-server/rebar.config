{erl_opts, [debug_info, {i, "src/generated"}]}.
{src_dirs, [{"src", [{recursive, true}]}]}.

{deps, [
    {cowboy, "2.12.0"},
    {jsone,  "1.8.0"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all, nowarn_unused_vars,
                    {i, "src/generated"}]}
    ]}
]}.

{eunit_opts, [verbose]}.
