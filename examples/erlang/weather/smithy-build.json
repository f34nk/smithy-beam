{
  "version": "1.0",
  "sources": ["model"],
  "maven": {
    "repositories": [
      { "url": "file://~/.m2/repository" }
    ],
    "dependencies": [
      "io.smithy.beam:codegen-erlang:0.1.0-SNAPSHOT"
    ]
  },
  "plugins": {
    "erlang-client-codegen": {
      "service": "example.weather#Weather",
      "module":  "weather",
      "edition": "2025",
      "outputDir": "src/generated/client"
    },
    "erlang-server-codegen": {
      "service": "example.weather#Weather",
      "module":  "weather",
      "edition": "2025",
      "outputDir": "src/generated/server"
    }
  }
}
