{erl_opts, [debug_info]}.

{deps, [
    {jsx, "3.1.0"}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [
            debug_info,
            {i, "src/generated"}
        ]},
        {dialyzer, [
            {plt_extra_apps, [meck, eunit]},
            {warnings, [unknown, unmatched_returns, error_handling]}
        ]}
    ]}
]}.

{shell, [
    {apps, [jsx]}
]}.

{eunit_opts, [verbose]}.

{plugins, [{rebar3_dialyzer_html, "0.3.0"}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {output_format, raw}
]}.
