{
  "version": "1.0",
  "sources": [
    "model/greeting.smithy"
  ],
  "maven": {
    "dependencies": [
      "io.smithy.beam:codegen-erlang:0.1.0-SNAPSHOT",
      "io.smithy.beam.examples:minimal-custom-protocol-codegen:0.1.0-SNAPSHOT"
    ],
    "repositories": [
      {
        "url": "https://repo1.maven.org/maven2"
      },
      {
        "url": "file://${user.home}/.m2/repository"
      }
    ]
  },
  "plugins": {
    "erlang-client-codegen": {
      "service": "smithy.beam.demo.custom_protocol#GreetingService",
      "edition": "2026",
      "protocol": "smithy.beam.demo.custom_protocol#ndjsonProtocol"
    }
  }
}
