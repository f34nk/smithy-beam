{
  "version": "1.0",
  "sources": [
    "../../model/basic.smithy"
  ],
  "maven": {
    "dependencies": [
      "io.smithy.beam:codegen-elixir:0.1.0-SNAPSHOT"
    ],
    "repositories": [
      {
        "url": "https://repo1.maven.org/maven2"
      },
      {
        "url": "file://${user.home}/.m2/repository"
      }
    ]
  },
  "plugins": {
    "elixir-client-codegen": {
      "service": "smithy.beam.demo.basic#BasicService",
      "edition": "2026"
    },
    "elixir-server-codegen": {
      "service": "smithy.beam.demo.basic#BasicService",
      "edition": "2026"
    }
  }
}
