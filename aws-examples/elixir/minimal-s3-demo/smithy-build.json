{
  "version": "1.0",
  "sources": [
    "model/s3-minimal.smithy"
  ],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-aws-traits:1.54.0",
      "software.amazon.smithy:smithy-waiters:1.70.0",
      "io.smithy.beam:codegen-elixir:0.1.0-SNAPSHOT"
    ],
    "repositories": [
      {
        "url": "https://repo1.maven.org/maven2"
      },
      {
        "url": "file://${user.home}/.m2/repository"
      }
    ]
  },
  "plugins": {
    "elixir-client-codegen": {
      "service": "com.amazonaws.s3#AmazonS3",
      "edition": "2026"
    }
  }
}
