{plugins, [rebar3_path_deps]}.

{erl_opts, [debug_info, {i, "src/generated"}]}.
{src_dirs, [{"src", [{recursive, true}]}]}.

{deps, [
    {jsone, "1.8.0"},
    {aws_signature, "0.3.2"},
    {aws_credentials, "1.0.5"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all, nowarn_unused_vars, {i, "src/generated"}]}
    ]}
]}.

{eunit_opts, [verbose]}.
