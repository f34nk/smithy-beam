{erl_opts, [debug_info, {i, "src/generated"}, {i, "../../../runtime/erlang"}]}.

%% Include generated code from subdirectory
{src_dirs, ["src", "src/generated", "../../../runtime/erlang"]}.

{deps, [
    {jsone, "1.8.0"},
    {aws_signature, "0.3.2"},
    {aws_credentials, "1.0.5"}
]}.

{profiles, [
    {test, [
        {deps, [
        ]},
        {erl_opts, [
            debug_info,
            {i, "src/generated"},  % Include path for generated headers
            {i, "../../../runtime/erlang"}
        ]},
        {dialyzer, [
            % Include test dependencies in PLT
            {plt_extra_apps, [eunit]},
            {warnings, [unknown, unmatched_returns, error_handling]}
        ]}
    ]}
]}.

{shell, [
    {apps, []}
]}.

{eunit_opts, [verbose]}.

{plugins, [{rebar3_dialyzer_html, "0.3.0"}]}.

{dialyzer, [
    % Enable useful warnings, but not overspecs
    {warnings, [unknown, unmatched_returns, error_handling]},
    % rebar3_dialyzer_html plugin requires raw output format
    {output_format, raw}
]}.
