{
  "version": "1.0",
  "sources": ["model"],
  "plugins": {
    "erlang-client-codegen": {
      "service": "example.weather#Weather",
      "module":  "weather",
      "edition": "2025",
      "outputDir": "src/generated"
    },
    "erlang-server-codegen": {
      "service": "example.weather#Weather",
      "module":  "weather",
      "edition": "2025",
      "outputDir": "src/generated"
    },
    "elixir-client-codegen": {
      "service":   "example.weather#Weather",
      "namespace": "Weather",
      "edition":   "2025",
      "outputDir": "lib/generated"
    },
    "elixir-server-codegen": {
      "service":   "example.weather#Weather",
      "namespace": "Weather",
      "edition":   "2025",
      "outputDir": "lib/generated"
    }
  }
}
